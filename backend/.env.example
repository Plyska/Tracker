# Tracker backend — приклад env. Скопіюй у `.env` і заповни.
# Реальний `.env` у git НЕ потрапляє (.gitignore).

# --- База даних (Neon PostgreSQL) ---
# Prisma 7: рантайм конектиться через driver adapter (node-postgres), міграції/CLI — через
# prisma.config.ts (DIRECT_URL). Якщо node-postgres лає `sslmode`, додай `&uselibpqcompat=true`.
# Pooled connection (runtime). Приклад Neon: ...-pooler.<region>.neon.tech/...?sslmode=require
DATABASE_URL="postgresql://user:password@host-pooler.region.neon.tech/tracker?sslmode=require"
# Direct connection (для prisma migrate). Без пулера.
DIRECT_URL="postgresql://user:password@host.region.neon.tech/tracker?sslmode=require"

# --- Auth ---
# Секрет для підпису access-JWT (>= 32 символи). Згенеруй: openssl rand -base64 48
# У ПРОДІ плейсхолдер нижче заборонено — сервер не стартує (env.ts guard).
JWT_ACCESS_SECRET="change-me-access-secret"
# (Опційно) попередній секрет для zero-downtime ротації: старий секрет сюди, новий — у
# JWT_ACCESS_SECRET; старі живі токени валідуються ще ~ACCESS_TOKEN_TTL. Прибрати після вікна.
# JWT_ACCESS_SECRET_PREVIOUS=""
# TTL токенів
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# --- HTTP ---
PORT="3000"
NODE_ENV="development"
# Дозволений origin фронтенду (CORS, credentials). Кома-розділений список.
CORS_ORIGIN="http://localhost:5173"

# --- AI-компаньйон (ADR 0012, docs/ai-agent-plan.md) ---
# Провайдер за швом: groq | gemini | anthropic. Зміна провайдера — env, не код.
# groq (дефолт) — OpenAI-сумісний API; та сама реалізація тягне Cerebras/OpenRouter через AI_BASE_URL.
AI_PROVIDER="groq"
# Ключ Groq: https://console.groq.com/keys (безкоштовний тир, картка не потрібна).
# Free: 30 RPM / 1000 запитів і 200k токенів на добу. Платний Developer — та сама модель,
# лише зняті ліміти (250k TPM), без абонплати.
GROQ_API_KEY=""
# Базовий URL OpenAI-сумісного провайдера. Порожньо — дефолт за провайдером
# (groq → https://api.groq.com/openai/v1). Задається лише щоб націлити на іншого сумісного.
# AI_BASE_URL=""
# Ключ Gemini: Google AI Studio → https://aistudio.google.com (безкоштовний тир, картка не потрібна).
# Локально ключ ОПЦІЙНИЙ (без нього /ai/* віддає 503 AI_UNAVAILABLE, решта працює);
# у ПРОДІ обов'язковий — сервер не стартує (env.ts guard, як для JWT_ACCESS_SECRET).
# Free tier використовує запити для покращення моделей — див. план §3.6 (міграція на платний тир).
GEMINI_API_KEY=""
# (Альтернативний провайдер) Anthropic Console → https://console.anthropic.com
# ANTHROPIC_API_KEY=""
# Модель (опц.). Дефолт за провайдером: groq → openai/gpt-oss-120b,
# gemini → gemini-3.7-flash, anthropic → claude-opus-5.
# Безкоштовний тир Gemini рахує квоту НА МОДЕЛЬ: 5 запитів/хв і 20/добу. Тобто коли модель
# «скінчилась» на сьогодні (у логах: «добова квота цієї моделі вичерпана»), чекати не треба —
# перемкни на сусідню, у неї власний лічильник: gemini-3.5-flash / 3.6 / 3.7 / 3.8.
# Найновіша при цьому найзавантаженіша (3.8 стабільно віддавав 503 «high demand»).
# AI_MODEL="gemini-3.6-flash"
# Денна квота LLM-запитів на користувача (лист / чек-ін / чат) → 429 AI_QUOTA_EXCEEDED.
AI_DAILY_MESSAGE_LIMIT="20"
# Стеля розміру контекст-паку (токени, орієнтовно) — рахунок не росте з історією.
AI_CONTEXT_MAX_TOKENS="6000"
