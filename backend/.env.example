# Tracker backend — приклад env. Скопіюй у `.env` і заповни.
# Реальний `.env` у git НЕ потрапляє (.gitignore).

# --- База даних (Neon PostgreSQL) ---
# Prisma 7: рантайм конектиться через driver adapter (node-postgres), міграції/CLI — через
# prisma.config.ts (DIRECT_URL). Якщо node-postgres лає `sslmode`, додай `&uselibpqcompat=true`.
# Pooled connection (runtime). Приклад Neon: ...-pooler.<region>.neon.tech/...?sslmode=require
DATABASE_URL="postgresql://user:password@host-pooler.region.neon.tech/tracker?sslmode=require"
# Direct connection (для prisma migrate). Без пулера.
DIRECT_URL="postgresql://user:password@host.region.neon.tech/tracker?sslmode=require"

# --- Auth ---
# Секрет для підпису access-JWT (>= 32 символи). Згенеруй: openssl rand -base64 48
# У ПРОДІ плейсхолдер нижче заборонено — сервер не стартує (env.ts guard).
JWT_ACCESS_SECRET="change-me-access-secret"
# (Опційно) попередній секрет для zero-downtime ротації: старий секрет сюди, новий — у
# JWT_ACCESS_SECRET; старі живі токени валідуються ще ~ACCESS_TOKEN_TTL. Прибрати після вікна.
# JWT_ACCESS_SECRET_PREVIOUS=""
# TTL токенів
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# --- HTTP ---
PORT="3000"
NODE_ENV="development"
# Дозволений origin фронтенду (CORS, credentials). Кома-розділений список.
CORS_ORIGIN="http://localhost:5173"

# --- AI-компаньйон (ADR 0012, docs/ai-agent-plan.md) ---
# Провайдер за швом: groq | gemini | anthropic. Зміна провайдера — env, не код.
# groq (дефолт) — OpenAI-сумісний API; та сама реалізація тягне Cerebras/OpenRouter через AI_BASE_URL.
AI_PROVIDER="groq"
# Ключ Groq: https://console.groq.com/keys (безкоштовний тир, картка не потрібна).
# Free: 30 RPM / 1000 запитів і 200k токенів на добу. Платний Developer — та сама модель,
# лише зняті ліміти (250k TPM), без абонплати.
GROQ_API_KEY=""
# Базовий URL OpenAI-сумісного провайдера. Порожньо — дефолт за провайдером
# (groq → https://api.groq.com/openai/v1). Задається лише щоб націлити на іншого сумісного.
# AI_BASE_URL=""
# Ключ Gemini: Google AI Studio → https://aistudio.google.com (безкоштовний тир, картка не потрібна).
# Локально ключ ОПЦІЙНИЙ (без нього /ai/* віддає 503 AI_UNAVAILABLE, решта працює);
# у ПРОДІ обов'язковий — сервер не стартує (env.ts guard, як для JWT_ACCESS_SECRET).
# Free tier використовує запити для покращення моделей — див. план §3.6 (міграція на платний тир).
GEMINI_API_KEY=""
# (Альтернативний провайдер) Anthropic Console → https://console.anthropic.com
# ANTHROPIC_API_KEY=""
# Модель (опц.). Дефолт за провайдером: groq → openai/gpt-oss-120b,
# gemini → gemini-3.7-flash, anthropic → claude-opus-5.
# Безкоштовний тир Gemini рахує квоту НА МОДЕЛЬ: 5 запитів/хв і 20/добу. Тобто коли модель
# «скінчилась» на сьогодні (у логах: «добова квота цієї моделі вичерпана»), чекати не треба —
# перемкни на сусідню, у неї власний лічильник: gemini-3.5-flash / 3.6 / 3.7 / 3.8.
# Найновіша при цьому найзавантаженіша (3.8 стабільно віддавав 503 «high demand»).
# AI_MODEL="gemini-3.6-flash"
# Денна квота LLM-запитів на користувача (лист / чек-ін / чат) → 429 AI_QUOTA_EXCEEDED.
# 15 — продуктове рішення, не тимчасове: стеля на ОДНОГО користувача, щоб він не вичерпав запас
# на всіх. Вона лишається і на платному тирі, де змінюється лише те, чим саме вона обмежує:
# на безкоштовному — спільною стелею ключа, на платному — рахунком.
# Порядок величин: один виклик ≈4 200 токенів, тобто 15/добу ≈ 63 000 токенів на людину на день
# і ≈1,9 млн на місяць у найгіршому разі. Заміряно 2026-09-09.
AI_DAILY_MESSAGE_LIMIT="15"
# Стеля розміру контекст-паку (токени, орієнтовно) — рахунок не росте з історією.
AI_CONTEXT_MAX_TOKENS="6000"

# --- Транзакційна пошта (підтвердження адреси, скидання пароля) ---
# Провайдер за швом `EmailTransport` (lib/email/transport.ts) — як і в AI: зміна = env, не код.
# Порожньо → `console`: лист друкується в stdout разом із кодом/посиланням. Це РОБОЧИЙ режим
# розробки, обидва флоу проходяться повністю без домену й DNS.
# У ПРОДІ `console` заборонено — сервер не стартує (env.ts guard): мовчазна відмова пошти тут
# невідрізненна від успіху (усі ці ендпоінти віддають 204 навмисно), тож людина, яка забула
# пароль, ніколи б не дізналась, що лист не пішов.
# EMAIL_PROVIDER="resend"

# Ключ Resend: https://resend.com/api-keys (free tier: 3 000 листів/міс, 100/добу; картка не потрібна).
# Права достатньо `Sending access` — повний доступ цьому сервісу не потрібен.
RESEND_API_KEY=""

# Відправник — на ПІДДОМЕНІ `mail.`, не на корені: репутація відправлення тримається окремо, щоб
# майбутня розсилка не псувала доставлюваність листів про пароль (docs/dns-subdomains.md).
# Домен МУСИТЬ бути верифікований у Resend (DKIM + 2 CNAME), інакше лист або не піде, або впаде в спам. `onboarding@resend.dev` працює без домену, але шле листи ЛИШЕ
# на адресу власника акаунта — для локальної перевірки, не для прода.
EMAIL_FROM="Tellday <no-reply@mail.tellday.app>"

# Базовий URL фронтенду для посилань у листах (скидання пароля). Не виводимо з CORS_ORIGIN:
# там може бути список, а в лист треба рівно одну адресу — помилка тут відправляє людину
# в чужий застосунок.
APP_URL="http://localhost:5173"

# Домен для CSRF-cookie — ПОТРІБЕН, лише коли фронт і API на різних піддоменах одного домену
# (tellday.app ↔ api.tellday.app). Без нього cookie від api.* стає host-only, JS на фронті його
# не читає, і кожна мутація віддає 403 INVALID CSRF. Локально (localhost:5173 ↔ :3000) не потрібен.
# Застосовується ТІЛЬКИ до csrf-cookie; access/refresh лишаються host-only свідомо.
# Деталі — docs/dns-subdomains.md
# COOKIE_DOMAIN=".tellday.app"

# --- Rate limiting: спільні лічильники (Upstash Redis) ---
# Потрібні на SERVERLESS (Vercel Fluid compute), де інстансів кілька. Дефолтний MemoryStore
# тримає лічильники в пам'яті процесу, тож кожен інстанс веде власний, і фактичний ліміт стає
# «ліміт × інстанси» — захист від перебору паролів тихо слабшає саме тоді, коли росте трафік.
# Порожньо — MemoryStore; для локальної розробки це правильно, Redis піднімати не треба.
# У проді без них сервер стартує, але пише попередження [rate-limit] у лог.
# Заводиться через Vercel → Storage → Upstash (безкоштовний тир); імена змінних платформа
# виставляє сама, саме ці. Деталі — docs/dns-subdomains.md
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Вільна розмова з помічником (POST /ai/chat). ВИМКНЕНО за замовчуванням до запуску: на відміну
# від чек-іну й підказок, чат приймає довільний текст і віддає його моделі разом із контекстом
# акаунта — інший клас ризику (prompt injection, спроби дістати чужий контекст, накрутка рахунку).
# Решта AI-функцій працює як раніше. Вмикати рівно значенням "true".
# Фронт має ПАРНИЙ прапорець ASSISTANT_CHAT_ENABLED (shared/config/features.ts) — перемикати разом.
# AI_CHAT_ENABLED="true"

# --- Моніторинг помилок (Sentry) ---
# Порожньо — SDK не вмикається зовсім: локально помилки видно в терміналі, і засмічувати ними
# прод-проєкт не треба (та сама логіка, що з `console`-поштою й MemoryStore для лімітів).
# Проєкт `tellday-api` в організації EU-регіону → хост DSN містить `ingest.de.sentry.io`.
# У Sentry летять ЛИШЕ неочікувані помилки (не AppError) і без тіл, cookie, заголовків,
# локальних змінних і query — див. src/instrument.ts.
# SENTRY_DSN=""
