# Базовий URL REST API (Express). Шляхи контракту монтуються в корінь (/auth, /habits, /entries),
# тож БЕЗ суфікса /api. Refresh-cookie має scope /auth — refresh-запит мусить лишатись на цьому хості.
VITE_API_URL=http://localhost:3000

# Моніторинг помилок (Sentry)
# Порожньо — SDK не вмикається (локально помилки видно в консолі браузера).
# Проєкт `tellday-web`, EU-регіон. Змінна ЗБІРКИ: після зміни потрібен перезбір, не рестарт.
# У Sentry летять помилки без тіл, cookie, заголовків, локальних змінних і query; console-крихти
# вимкнено, Session Replay не підключено — див. src/app/sentry.ts
VITE_SENTRY_DSN=""
