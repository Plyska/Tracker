// Tracker — схема БД. Дзеркалить доменні моделі (docs/data-models.md) і контракт
// (docs/api-contract.md). `plan` НЕ зберігається — похідне від підписки (mapper повертає 'pro'
// на час релізу; монетизація — пізніша фаза).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Prisma 7: конект-URL більше не тут — рантайм через driver adapter (src/prisma.ts),
  // міграції/CLI — через prisma.config.ts (datasource.url = DIRECT_URL).
  provider = "postgresql"
}

enum Role {
  user
  admin
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  avatarUrl    String?
  passwordHash String? // null = OAuth-only акаунт (шов на майбутнє)
  role         Role     @default(user)
  createdAt    DateTime @default(now())
  // Момент підтвердження пошти; null = не підтверджено. Датою, а не булевим: «коли» потрібне і
  // для підтримки («лист точно дійшов о такій-то»), і як доказ, що адреса була робочою.
  // Користуватись застосунком це НЕ блокує (рішення: конверсія важливіша) — але без підтвердження
  // відновлення пароля не має куди слати лист, тож ми про це нагадуємо.
  emailVerifiedAt DateTime?

  habits        Habit[]
  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]
  dailyLogs     DailyLog[]
  tasks         Task[]
  preferences   UserPreferences?
  aiReflections AiReflection[]
  aiUsage       AiUsage[]
}

// Клієнтські налаштування, перенесені з localStorage у БД (per-user, крос-девайс).
// 1:1 з User; усі поля nullable = «не задано» → фронт застосовує дефолт. Розширюється колонками.
model UserPreferences {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme             String? // 'light' | 'dark'
  accent            String? // ключ акцентної палітри
  locale            String? // 'en' | 'uk'
  tableLayout       String? // 'columns' | 'rows'
  statsGoalPct      Int? // ціль виконання, 0..100 (null = без цілі)
  hiddenStatWidgets String[] @default([]) // ключі прихованих віджетів статистики
  editorScale       Float? // масштаб тексту редактора дня (zoom), 0.8..1.5 (null = дефолт 1)
  // AI-помічник (ADR 0012). Усі null = не задано → фронт трактує як false.
  aiEnabled    Boolean? // помічник увімкнено (гейт /ai/*; вмикається через екран згоди)
  aiDiaryOptIn Boolean? // ОКРЕМИЙ дозвіл читати щоденник (OFF за замовч.; без нього notes не потрапляють у контекст)
  aiConsentAt  DateTime? // момент згоди — ставить сервер при першому aiEnabled=true (GDPR-доказ)
  // Граматичний рід звертання: 'masculine' | 'feminine'. Питаємо НЕ стать, а форму звертання:
  // потрібен рід дієслова, не ідентичність. Третього значення немає свідомо — заборонна
  // інструкція («не вживай форм із родом») моделлю не виконувалась. null = не питали (згоду дано
  // на англійському інтерфейсі); тоді промпт обходиться без роду.
  // Має значення лише для української; в англійському промпті не використовується.
  aiAddressForm String?
  updatedAt         DateTime @updatedAt
  // Прим.: ширина колонки навичок (habitColWidth) свідомо лишається лише в localStorage
  // (per-device, не крос-девайс) — у БД не переноситься.
}

model Habit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String
  icon      String?
  // Тижнева ціль частоти: null = щоденна звичка (метрики рахують кожен день); 1..6 = «N разів
  // на тиждень» (статистика рахує по Пн–Нд-тижнях, знаменник = повна ціль). Деталі — ADR 0010.
  weeklyTarget Int?
  // Часова навичка: null = не часова; >0 = тижнева ціль у ХВИЛИНАХ (у формі задається в годинах).
  // Взаємовиключне з weeklyTarget (гарантує форма+zod). `done` за день = minutes>0. Деталі — ADR 0011.
  weeklyMinutesTarget Int?
  // Soft-delete (кошик): null = активна; не-null = у кошику, остаточне видалення через
  // TRASH_RETENTION_DAYS (lib/habitTrash). Замінює колишній `archived`-прапорець.
  deletedAt DateTime?
  createdAt DateTime @default(now())

  entries HabitEntry[]
  tasks   Task[]

  @@index([userId])
  @@index([deletedAt])
}

model HabitEntry {
  id      String  @id @default(cuid())
  habitId String
  habit   Habit   @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date    String // 'YYYY-MM-DD' — рядок, матчить ISO-інваріант контракту (без TZ-пасток)
  done    Boolean @default(true)
  // Хвилини за день для часової навички (ADR 0011): null для бінарних; 0..1440 для часових.
  // Рядок існує лише поки minutes>0 (для часових) або done (для бінарних) — sparse-модель.
  minutes Int?

  // Унікальний ключ запису (habitId+date) — основа upsert у PUT /entries
  @@unique([habitId, date])
  @@index([habitId])
}

// Щоденний настрій/нотатки (docs/data-models.md). Окремий ЖЦ від HabitEntry: про день у цілому,
// не про звичку. Sparse — один запис на день. Передумова mood-кореляції (stats).
model DailyLog {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String // 'YYYY-MM-DD' — той самий ISO-інваріант (без TZ-пасток)
  mood   Int // 1–5 (валідація на вході zod-схемою)
  notes  String?

  // Унікальний ключ (userId+date) — основа upsert у PUT /daily-logs
  @@unique([userId, date])
  @@index([userId])
}

// Задача розпорядку дня / списку справ (docs/data-models.md). Прив'язана до дати; `startTime`/
// `endTime` ('HH:mm', локальний час без TZ — ADR 0009) опційні: задані ⇒ елемент розпорядку,
// відсутні ⇒ елемент списку справ. `habitId` — опційна мітка на навичку (SetNull при її видаленні).
model Task {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String? // 'YYYY-MM-DD' (без TZ); null = без дати → «Загальна» картка
  title     String
  startTime String? // 'HH:mm' (локальний, без TZ)
  endTime   String? // 'HH:mm'
  habitId   String?
  habit     Habit?   @relation(fields: [habitId], references: [id], onDelete: SetNull)
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([habitId])
}

// AI-компаньйон (ADR 0012): кеш згенерованих підсумків. Один рядок на (user, period, periodKey):
// повторне відкриття віддає з кешу (0 токенів), а історія підсумків — побічний ефект кешу.
// `content` — structured output листа; ЧУТЛИВЕ (може містити переказ щоденника) — ніколи в логи.
model AiReflection {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period       String // 'week' | 'month'
  periodKey    String // ISO-тиждень '2026-W36' або місяць '2026-09'
  locale       String // 'en' | 'uk' — лист генерується мовою локалі на момент генерації
  // Форма звертання на момент генерації. Тут заради ВАЛІДНОСТІ КЕШУ, а не аудиту: без неї
  // зміна роду в Налаштуваннях не оновлювала б уже згенерований лист, і фіча виглядала б
  // зламаною саме там, де її вмикають. Та сама пастка, що була з локаллю.
  addressForm  String? // null = згенеровано до появи поля
  content      Json // {headline, highlights[], slips[], pattern, question}
  model        String // id моделі-генератора (аудит/порівняння якості)
  inputTokens  Int
  outputTokens Int
  createdAt    DateTime @default(now())

  @@unique([userId, period, periodKey])
  @@index([userId])
}

// Квоти AI на день (ADR 0012): лічильник запитів/токенів на користувача. Перевищення ліміту →
// 429 AI_QUOTA_EXCEEDED. `day` — локальна дата клієнта (як `to` у /stats), без TZ-дрейфу.
model AiUsage {
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day          String // 'YYYY-MM-DD'
  messages     Int    @default(0)
  inputTokens  Int    @default(0)
  outputTokens Int    @default(0)

  @@id([userId, day])
}

// Refresh-токени: ротація + reuse-detection. Зберігаємо лише SHA-256 хеш непрозорого токена.
// При повторному використанні відкликаного токена відкликаємо всю `family` (захист від крадіжки).
/**
 * Одноразові токени, що приходять поштою: підтвердження адреси й скидання пароля.
 *
 * Одна таблиця на обидва призначення, бо життєвий цикл ідентичний (видали → надіслали → спожили
 * або протух), а різниця лише в `type` і TTL. Дві таблиці дублювали б і код, і прибирання.
 *
 * У БД — **лише SHA-256 хеш**, як у `RefreshToken`: дамп бази не має давати можливості скинути
 * комусь пароль. Сирий токен існує рівно один раз — у листі.
 */
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // 'verify' | 'reset'
  tokenHash String    @unique // sha256(opaque token)
  expiresAt DateTime
  usedAt    DateTime? // одноразовість: спожитий токен не приймається вдруге
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([expiresAt]) // для прибирання простроченого (db:cleanup)
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    String // спільний id ланцюга ротації
  tokenHash String    @unique // sha256(opaque token)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([family])
}
